# Keep this file as a template; never commit actual credentials.
OPENAI_API_KEY=replace_with_your_openai_api_key
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Process-local usage controls. See README for limitations.
BOT_MAX_TEXT_PER_HOUR=5
BOT_MAX_IMAGES_PER_HOUR=1
BOT_MAX_CONCURRENT=3
BOT_MAX_TRACKED_USERS=4096
